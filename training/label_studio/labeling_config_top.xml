<!--
  Label Studio labeling config for the FRONT side (Side A, "top" dataset).
  Paste into Project > Settings > Labeling Interface > Code.
  Label values MUST be spelled exactly like this (they become class names).
  PCB X front parts (15): F1 fuse, C13 film_capacitor (red X2 box), VAR1 varistor
  (dark-blue disc), C10 ceramic_capacitor (light-blue Y disc), L1 + L2 inductor,
  T1 transformer, C1 C2 C3 C6 C(next to C6) C12 electrolytic_cap, CN1 + PWR1 connector.
  JMP02 (wire jumper) is not labelled.
-->
<View>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>
  <RectangleLabels name="label" toName="image" strokeWidth="2" opacity="0.25">
    <Label value="electrolytic_cap"  hotkey="1" background="#e53935"/>
    <Label value="film_capacitor"    hotkey="2" background="#ad1457"/>
    <Label value="ceramic_capacitor" hotkey="3" background="#039be5"/>
    <Label value="varistor"          hotkey="4" background="#00897b"/>
    <Label value="fuse"              hotkey="5" background="#fdd835"/>
    <Label value="inductor"          hotkey="6" background="#8e24aa"/>
    <Label value="transformer"       hotkey="7" background="#3949ab"/>
    <Label value="connector"         hotkey="8" background="#fb8c00"/>
  </RectangleLabels>
</View>
